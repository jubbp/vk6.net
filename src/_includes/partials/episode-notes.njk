{%- if ep.items.length %}
<ul class="notes">
  {%- for it in ep.items %}
  <li>{% if it.start or it.start === 0 %}{% if notesSeek %}<button type="button" class="t" data-at="{{ it.start }}" aria-label="Play from {{ it.start | clock }}">{{ it.start | clock }}</button>{% else %}<span class="t">{{ it.start | clock }}</span>{% endif %} {% endif %}{% if it.segment %}<strong>{{ it.segment }}:</strong> {% endif %}{{ it.topic }}
    {%- if it.notes and it.notes.length %}<ul>{% for n in it.notes %}<li>{{ n }}</li>{% endfor %}</ul>{% endif %}
  </li>
  {%- endfor %}
</ul>
{%- elif ep.summary %}
<p>{{ ep.summary }}</p>
{%- endif %}
{%- if ep.producer %}<p class="small muted">Produced by {{ ep.producer }}.</p>{% endif %}

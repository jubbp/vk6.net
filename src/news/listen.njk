---
layout: layouts/base.njk
title: Listen
description: Play the latest NewsWest, browse every episode and search the show notes.
permalink: /news/listen/
scripts: [/assets/js/listen.js]
eleventyComputed:
  jsonld:
    "@context": https://schema.org
    "@type": PodcastSeries
    name: NewsWest
    url: "{{ '/news/listen/' | absolute(settings.url) }}"
    webFeed: "{{ settings.podcast.feed }}"
    author: { "@type": Organization, name: "{{ settings.org }}" }
---
{%- set latest = episodes[0] %}
<header class="page-head">
  <div class="wrap">
    <p class="eyebrow">NewsWest</p>
    <h1>Listen</h1>
    <div class="lede">{{ pages.listen.html | safe }}</div>
  </div>
</header>

<div class="wrap listen-grid">
  {%- if latest %}
  <div>
    {%- set ep = latest %}{% set playerLabel = "Latest episode" %}{% set notesSeek = true %}
    {% include "partials/player.njk" %}
    <div class="lead-notes" data-np-notes>{% include "partials/episode-notes.njk" %}</div>
  </div>
  {%- else %}
  <section class="card"><p>Episodes are being loaded. Meanwhile, every episode is at <a href="{{ settings.podcast.audioHost }}">audio.vk6.net</a>.</p></section>
  {%- endif %}

  <aside>
    {% include "partials/subscribe-card.njk" %}
  </aside>
</div>

<section class="wrap archive" aria-labelledby="archive-heading">
  <div class="archive-head">
    <h2 id="archive-heading">All episodes</h2>
    <form class="archive-tools" role="search" onsubmit="return false">
      <label class="sr-only" for="q">Search every episode's show notes</label>
      <input id="q" type="search" placeholder="Search: a club, callsign or topic" autocomplete="off" data-search>
    </form>
  </div>
  <p class="small muted" aria-live="polite" data-count>{{ episodes.length }} episodes</p>
  {%- for y in episodes | byYear %}
  <details class="year" data-year-group {% if loop.first %}open{% endif %}>
    <summary><span class="year-label">{{ y.year }}</span> <span class="year-count" data-year-count>{{ y.episodes.length }} episodes</span></summary>
    <ol class="episode-list">
      {%- for ep in y.episodes %}
      <li data-search="{{ ep.search }}">
        <button type="button" class="play" data-play data-audio="{{ ep.audio }}" data-title="{{ ep.longDate }}" data-link="{{ ('/episodes/' + ep.slug + '/') | url }}" aria-label="Play {{ ep.title }}"><span aria-hidden="true">▶</span></button>
        <div class="ep-row">
          <h3><a href="{{ ('/episodes/' + ep.slug + '/') | url }}">{{ ep.longDate }}</a></h3>
          {%- if ep.items.length %}<p class="ep-topics">{% for it in ep.items %}{{ it.topic }}{% if not loop.last %} · {% endif %}{% endfor %}</p>{% endif %}
          <div class="ep-notes" hidden>{% include "partials/episode-notes.njk" %}</div>
        </div>
      </li>
      {%- endfor %}
    </ol>
  </details>
  {%- endfor %}
  <p class="no-results" data-none hidden>No episodes match that search. Try a callsign, a club name or a single word.</p>
  <p class="small muted archive-foot">Older material: <a href="{{ settings.podcast.audioHost }}">audio.vk6.net</a> has every file, including text editions and video broadcasts.</p>
</section>

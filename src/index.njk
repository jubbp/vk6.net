---
layout: layouts/base.njk
bodyClass: home
jsonld:
  "@context": https://schema.org
  "@type": Organization
  name: WA Amateur Radio News Inc
  alternateName: [WA Amateur Radio News, WAARN]
  url: https://www.vk6.net/
  email: newswest@vk6.net
  foundingDate: "2015-01"
---
{%- set latest = episodes[0] %}
<section class="front">
  <div class="wrap front-grid">
    <div class="front-copy">
      <p class="kicker">{{ settings.show }} · every Sunday since 1931</p>
      <h1>Amateur radio news for Western Australia.</h1>
      <p class="lede">The clubs, contests, nets and people of VK6, on air across the state, online, and in your podcast app. Made by the volunteers of {{ settings.club }}.</p>
      <p class="actions">
        <a class="button" href="{{ '/news/listen/' | url }}">Listen now</a>
        <a class="button ghost" href="{{ '/news/broadcasts/' | url }}">Find it on air</a>
      </p>
    </div>
    {% include "partials/next-broadcast.njk" %}
  </div>
</section>

<div class="wrap lead-grid">
  <div class="lead-main">
    {%- if latest %}
    {%- set ep = latest %}{% set playerLabel = "This week on NewsWest" %}
    {% include "partials/player.njk" %}
    <div class="lead-notes">
      <h2 class="section-title">In this episode</h2>
      {% include "partials/episode-notes.njk" %}
      <p class="more"><a href="{{ '/news/listen/' | url }}">All episodes and search →</a></p>
    </div>
    {%- endif %}
  </div>
  <aside class="lead-side">
    {% include "partials/callbacks-card.njk" %}
    {% include "partials/subscribe-card.njk" %}
  </aside>
</div>

<section class="wrap section">
  <h2 class="section-title">Get involved</h2>
  <ul class="tiles">
    <li><a href="{{ '/news/contact/' | url }}"><strong>Submit your news</strong><span>Audio or text, by noon Friday</span></a></li>
    <li><a href="{{ '/news/relay/' | url }}"><strong>Relay NewsWest</strong><span>Put the news on air in your area</span></a></li>
    <li><a href="{{ '/perthtech/' | url }}"><strong>PerthTech</strong><span>Our technical day for amateurs</span></a></li>
    <li><a href="{{ '/support/' | url }}"><strong>Support our work</strong><span>Become a WAARN Supporter</span></a></li>
    <li><a href="{{ '/becoming-an-amateur/' | url }}"><strong>Get licensed</strong><span>Training clubs and free guides</span></a></li>
    <li><a href="{{ '/clubs/' | url }}"><strong>VK6 clubs</strong><span>Find a club near you</span></a></li>
    <li><a href="{{ '/news/coverage/' | url }}"><strong>Coverage map</strong><span>Every transmitter and repeater</span></a></li>
    <li><a href="{{ '/subscribe/' | url }}"><strong>Subscribe</strong><span>Podcast or weekly email</span></a></li>
  </ul>
</section>

<section class="wrap section thanks">
  <div class="prose">{{ pages.home.html | safe }}</div>
</section>

{%- if clubNews.length %}
<section class="wrap section" aria-labelledby="cn-heading">
  <h2 class="section-title" id="cn-heading">Club news</h2>
  <ul class="post-list">
    {%- for post in clubNews | limit(3) %}
    <li><a href="{{ ('/club-news/' + post.slug + '/') | url }}"><time datetime="{{ post.date }}">{{ post.date }}</time><strong>{{ post.title }}</strong><span>{{ post.excerpt }}</span></a></li>
    {%- endfor %}
  </ul>
</section>
{%- endif %}

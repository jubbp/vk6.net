---
layout: layouts/base.njk
bodyClass: home
jsonld:
  "@context": https://schema.org
  "@type": Organization
  name: WA Amateur Radio News Inc
  alternateName: [WA Amateur Radio News, WAARN]
  url: https://www.vk6.net/
  email: newswest@vk6.net
  foundingDate: "2015-01"
---
{%- set latest = episodes[0] %}
<div class="wrap home-layout">
  <div class="home-main">
    <p class="kicker">{{ settings.show }} · every Sunday since 1931</p>
    <h1>Amateur radio news for Western Australia.</h1>
    <p class="lede">News from the clubs, contests, nets and people of VK6, every Sunday on the repeaters and HF, and any time online or in your podcast app. Made by the volunteers of {{ settings.club }}.</p>
    {%- if latest %}
    {%- set ep = latest %}{% set playerLabel = "This week on NewsWest" %}
    {% include "partials/player.njk" %}
    <div class="lead-notes">
      <h2 class="section-title">In this episode</h2>
      {% include "partials/episode-notes.njk" %}
      <p class="more"><a href="{{ '/news/listen/' | url }}">All episodes and search →</a></p>
    </div>
    {%- endif %}
  </div>
  <aside class="home-side">
    {% include "partials/callbacks-card.njk" %}
    {% include "partials/support-card.njk" %}
  </aside>
</div>
